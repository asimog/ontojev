# OntoJev local development template. Copy to `.env.local` and fill in secrets.
# `.env.local` is gitignored and loaded automatically by
# `cancerjev.config.load_local_env()`. Real process environment variables always
# win, blank values are ignored, and values are never logged or persisted.
# Set CANCERJEV_NO_DOTENV=1 to disable loading, or CANCERJEV_ENV_FILE=<path> to
# point at another file.

# --- Provider keys (server-side only; never commit real values) ---
# TypeSafe/Jev key for `python -m cancerjev run --live --jev`.
TYPESAFE_API_KEY=
# OpenRouter key for optional explicitly authorized bounded hypothesis generation.
OPENROUTER_API_KEY=

# --- Effective operational settings (Settings owns these; see docs/ARCHITECTURE.md) ---
# Every control below is honored. Settings may only lower a documented hard cap.
CANCERJEV_DATA_DIR=./data
CANCERJEV_RUN_INTERVAL_MINUTES=60
CANCERJEV_WEB_ORIGIN=http://localhost:3000
# Offline demo pacing only; 0 removes the simulated stage delays.
CANCERJEV_FIXTURE_STAGE_DELAY_MS=500
# GDC request controls (hard caps: 5242880 bytes per response, 30 s socket timeout).
CANCERJEV_GDC_PER_RESPONSE_BYTES=5242880
CANCERJEV_GDC_TIMEOUT_SECONDS=30
CANCERJEV_GDC_CACHE=1
# Jev wide-evaluation controls (hard caps: 1000 states per request, 30 s timeout).
CANCERJEV_JEV_MODEL=jev-1.13.0
CANCERJEV_JEV_MAX_STATES=1000
CANCERJEV_JEV_TIMEOUT_SECONDS=30
# Optional bounded hypothesis text provider (hard cap: 120 s timeout).
CANCERJEV_LLM_MODEL=deepseek/deepseek-v4.1-flash
CANCERJEV_LLM_TIMEOUT_SECONDS=120

# --- Retired, ignored, do not set ---
# These controls are no longer honored by any code path; setting them has no
# effect. Adaptive GDC request/page growth and Jev context bounds replaced them:
# CANCERJEV_GDC_MAX_REQUESTS, CANCERJEV_GDC_MAX_BYTES,
# CANCERJEV_JEV_MAX_ATTEMPTS, CANCERJEV_JEV_MAX_INPUT_TOKENS.

# --- Frontend ---
# Next.js reads apps/web/.env.local for NEXT_PUBLIC_* values, not this file.
NEXT_PUBLIC_CANCERJEV_API_URL=http://127.0.0.1:8000
